{{/* .zshrc script block */ -}}
{{/* {{ template "assets.d/gopass/dot_zshrc.sh.tmpl" . }} */ -}}
{{ template "assets.d/gopass/header.sh.tmpl" . }}
{{ if eq .chezmoi.os "linux" -}}
{{-  if (and (eq .chezmoi.osRelease.id "ubuntu") (.chezmoi.kernel.osrelease | lower | contains "microsoft")) }}
# Use Windows host GPG binary
export GOPASS_GPG_BINARY=/usr/local/bin/gpg

{{    template "assets.d/gopass/aliases.sh.tmpl" . }}
{{-  else -}}
{{    fail (printf "Unsupported OS for the client system: %s" .chezmoi.os) }}
{{-  end -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{   template "assets.d/gopass/aliases.sh.tmpl" . }}
{{- else if eq .chezmoi.os "windows" -}}
# TODO: Update setup windows gopass
{{- else -}}
{{   fail (printf "Unsupported OS for the client system: %s" .chezmoi.os) }}
{{ end -}}
