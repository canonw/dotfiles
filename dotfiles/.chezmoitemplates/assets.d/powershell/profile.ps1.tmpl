<## Utility functions #>
<#
.SYNOPSIS
    Convert multi line string into a single string
.NOTES
    Taken from https://powershellfaqs.com/convert-multiline-string-to-single-line-in-powershell/
#>
function Convert-MultilineToSingleLine {
    param (
        [Parameter(ValueFromPipeline=$true)]
        [string]$MultilineString,
        [Parameter(ValueFromPipeline=$false)]
        [string]$Separator = " "
    )

    # Replace newline characters with the specified separator
    return $MultilineString -replace "`r`n", $Separator
}

<#
.SYNOPSIS
    Convert clipboard string into a single string
.NOTES
#>
function Convert-ClipboardToSingleLine {
    param (
        [string]$Separator = " "
    )
    $b = Get-Clipboard | Out-String
    Convert-MultilineToSingleLine -MultilineString $b -separator $Separator
}

<## base64 #>
<#
.SYNOPSIS
    Convert input to base64 string value
#>
function Convert-ToBase64 {
    param (
        [Parameter(ValueFromPipeline=$true)]
        [string]
        $InputString
    )

    # Convert string to byte array
    $bytes = [System.Text.Encoding]::UTF8.GetBytes($inputString)

    # Convert byte array to Base64 string
    $base64String = [System.Convert]::ToBase64String($bytes)

    return $base64String
}

