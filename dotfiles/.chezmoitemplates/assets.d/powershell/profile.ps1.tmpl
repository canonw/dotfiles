<## Change Directory related #>
function Set-Location-Up { Set-Location ".." }
function Set-Location-Up2 { Set-Location "..\.." }
function Set-Location-Up3 { Set-Location "..\..\.." }
function Set-Location-Documents { Set-Location "$HOME\Documents" }
function Show-Location-Documents { Invoke-Item -Path "$HOME\Documents" }
function Set-Location-Home { Set-Location "$HOME" }
function Show-Location-Home { Invoke-Item -Path "$HOME" }
function Set-Location-GitRoot {
    $ErrorActionPreference = "Stop"

    try {
        $dir = $(git rev-parse --show-toplevel 2>&1)
        Push-Location
        Set-Location $dir
    }
    catch {
        Write-Error "$($_.Exception.Message)"
    }
}
function Set-Location-Nuget { Set-Location "$HOME\.nuget" }
function Set-Location-NugetConfig { Set-Location "$env:APPDATA\Nuget" }
function Set-Location-PowerShell { Set-Location "$env:USERPROFILE\Documents\WindowsPowerShell" }

<## Browser related #>
<#
.SYNOPSIS
    Open Microsoft Edge browser
#>
function Invoke-MsEdge {
    [CmdletBinding()]
    param (
        # Optional Url to open with
        [string]$Url = ""
    )
    Start-Process microsoft-edge:$Url
}

<## File related #>
function Set-Touch-File {
    $fileName = $args[0]
    if (-not(Test-Path $fileName)) {
        New-Item -ItemType File -Name $fileName
    }
    else {
        (Get-ChildItem $fileName).LastWriteTime = Get-Date
    }
}

<## Recycle bin realted #>
function Remove-ItemToRecycleBin {
    Param
    (
        [Parameter(Mandatory = $true, HelpMessage = 'Directory path of file path for deletion.', ValueFromPipeline = $true)]
        [String]$LiteralPath
    )
    
    Write-Debug("Start removing {0} to recycle bin" -f $LiteralPath)

    If ((Get-Item $LiteralPath).PSIsContainer) {
        $ItemType = 'Directory'
        $IsDirectory = $True
    } else {
        $ItemType = 'File'
        $IsDirectory = $False
    }

    Write-Verbose("Remove {0} {1} to recycle bin" -f $ItemType, $LiteralPath)
    If( $IsDirectory -eq $True )
    {
        [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteDirectory($LiteralPath,'OnlyErrorDialogs','SendToRecycleBin')
    }
    else
    {
        [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteFile($LiteralPath,'OnlyErrorDialogs','SendToRecycleBin')
    }

    Write-Debug("End removing {0} to recycle bin" -f $LiteralPath)
    Write-Debug("WhatIfPreference: {0}.  ConfirmPreference: {1}." -f $WhatIfPreference, $ConfirmPreference)
}

function Remove-ToRecycleBin {
    [CmdletBinding(SupportsShouldProcess = $true)]
    Param
    (
        [Parameter(Mandatory = $true, HelpMessage = 'Directory path of file path for deletion.', ValueFromPipeline = $true)]
        [String]$Path
    )

    $Items = Get-Item -Path $Path -ErrorAction SilentlyContinue

    if ($null -eq $Items) {
        Write-Error("'{0}' not found" -f $Path)

        return
    }

    Add-Type -AssemblyName Microsoft.VisualBasic

    $Items | ForEach-Object {
        If ($PSCmdlet.ShouldProcess($_, "Remove to Recycle Bin"))
        {
            Remove-ItemToRecycleBin $_
        }
    }
}

