{{/* lsd shell alias script block */ -}}
{{/* {{ template "assets.d/lsd/aliases.sh.tmpl" . }} */ -}}

{{- if (or (and (eq .chezmoi.os "linux") (.is_ubuntu_wsl))
        (eq .chezmoi.os "darwin")
        (eq .chezmoi.os "windows")) }}
if [[ $(command -v lsd) ]] ; then
    # alias ls='lsd'
    alias ll='lsd -l'
    alias la='lsd -a'
    alias lla='lsd -la'
    alias lt='lsd --tree'
fi

{{- else -}}
{{    fail (printf "Unsupported OS for the client system: %s" .chezmoi.os) }}
{{  end -}}
