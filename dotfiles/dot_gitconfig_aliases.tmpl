# -*-mode:gitconfig-*- vim:ft=gitconfig

# {{ .chezmoi.targetFile | replaceAllRegex .chezmoi.homeDir "~" }}
# =============================================================================
# Aliases for Git sourced by `~/.gitconfig`.


[alias]
    # Lists aliases in sorted order.  Colorize by pygmentize if available.
    #aliases = !git config --get-regexp ^alias\\. | sort | cut -c 7-
    aliases = "!f() { if command -v pygmentize &>/dev/null; then git config -l | grep alias | sort | cut -c 7- | pygmentize -l properties -O style=lightbulb; else git config -l | grep alias | sort | cut -c 7-; fi }; f"

    # Amends the currently staged files to the latest commit.
    amend = "!f() { echo 'redirect to alias cm-amend' && git cm-amend ; }; f"

    # Lists all branches.
    br = branch

    # Shows verbose output about branches.
    branches = branch -a

    # Clones a repository including all submodules.
    cl-r = clone --recursive

    # Lists the files with the most churn.
    churn = !git --no-pager log --name-only --oneline | grep -v ' ' | sort | uniq -c | sort -nr | head

    # Saves changes to the local repo.
    cm = commit

    # Commits all changes.
    cm-a = !git add -A && git commit -av

    # Amends the currently staged files to the latest commit.
    cm-amend = commit --amend --reuse-message=HEAD

    # Commits all changes in silent with WIP message
	cm-wip = !git add -A && git commit -m \"wip: update from $(echo `uname -a | awk '{print $2}'`) on $(echo `date +%FT%T%Z`)\"

    # Commits all .
    cm-a = !git add -A && git commit -av

    # Switches to a branch, but doesn't create it.
    co = checkout

    # Switches to a branch, creating it if necessary.
    co-b = "!f() { git checkout -b \"$1\" 2> /dev/null || git checkout \"$1\"; }; f"

    # Edit files in changed and not staged.
    ed-changed = "!f() { git diff --name-only --diff-filter=AM | xargs -I{} sh -c \"echo {} ; \"${1:-code}\" {}\" ; }; f"

    # Edit files in commits.  Default to HEAD commit.
    ed-cm = "!f() { git show --name-only --diff-filter=AM --pretty=format: \"${1:-HEAD}\" | xargs -I{} sh -c \"echo {} ; \"${2:-code}\" {}\" ; }; f"
    
    # Edit files in staged changes.
    ed-staged = "!f() { git diff --name-only --cached --diff-filter=AM | xargs -I{} sh -c \"echo {} ; \"${1:-code}\" {}\" ; }; f"

    # Shows list of files in a conflict state.
    conflicts = !git diff --name-only --diff-filter=U

    # Lists contributors with number of commits.
    contributors = shortlog --summary --numbered

    # Picks arbitrary commits by reference and appends them to the HEAD.
    cp = cherry-pick

    # Credits an author on the latest commit.
    credit = "!f() { git commit --amend --author \"$1 <$2>\" -C HEAD; }; f"

    # Shows the diff between the latest commit and the current state.
    d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"

    # Shows the diff between the state `$number` revisions ago and the current state.
    di = !"d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; d"

    # Discards changes to a file.
    discard = checkout --

    # Compare diff files visually.  Use Visual Studio Code as default.
	dt = difftool --no-prompt --tool=${1:-vscode}

    # Removes branches that have been merged with master (delete merged).
    dm = "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"

    # Pretty-prints object's content.
    dump = cat-file -p

    # Finds branches containing commit.
    fb = "!f() { git branch -a --contains $1; }; f"

    # Finds commits by source code.
    fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"

    # Log all the commits related to a file
    filelog = log -u

    # Append staged files to latest commit
    fixup = "!f() { git commit --fixup=$1 ; }; f"

    # Finds commits by commit message.
    fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"

    # Find tags containing commit
    ft = "!f() { git describe --always --contains $1; }; f"

    # Ignores case and skip binary files.
    grep = grep -Ii

    # Shows short SHA, description, and history graph of last 20 commits.
    l = log --pretty=oneline -n 20 --graph --abbrev-commit

    # Shows short SHA, description, history graph, author, and files of commits
	lf = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat

    # Shows short SHA, description, history graph, time, and author of commits.
    ll = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

    # Shows short SHA, date, description, history graph, and author of commits.
    lo = log --pretty=format:\"%Cred%h%Creset %Cgreen%ad%Creset | %s%C(auto)%d%Creset %C(bold blue)<%an>%Creset\" --graph --date=short

    # Writes dangling objects to lost and found.
    lost = fsck --lost-found

    # Pulls in remote changes for the current repository and all its submodules.
    pl = pull --recurse-submodules

    # Forces push without overwriting the work of others.
    pushf = push --force-with-lease

    # Aborts rebase.
    rba = rebase --abort

    # Stages modified files and continues rebase.
    rbc = "!f(){ git add -A && git rebase --continue; }; f"

    # Rebases interactively with the given number of latest commits.  2 by default.
    reb = "!r() { git rebase -i HEAD~${1:-2}; }; r"

    # Shows verbose output about remotes.
    remotes = remote -v

    # Restores savepoint.
    restore = "!f(){ git add -A && git commit -qm 'RESTORE SAVEPOINT'; git reset $1 --hard; }; f"

    # Removes the old tag with this name and tag the latest commit with it.
    retag = "!r() { git tag -d $1 && git push origin :refs/tags/$1 && git tag $1; }; r"

    # Rebases interactively.
    ri = "!f(){ git fetch origin && git rebase --interactive origin/${1-master}; }; f"

    # Move current directory to git repository root.
  	root = rev-parse --show-toplevel

    # Squash recent commit into one commit with recent commit message.
    # https://stackoverflow.com/a/21890252
    # don't squash as alias.  Used by git-extra
    rt-squash = "!f() { git reset --soft HEAD~${1:-1} && git commit --edit -m \"$(git log --format=%B --reverse HEAD..HEAD@{1})\" ; }; f"

    # Sets origin remote.
    set-origin = remote set-url origin

    # Sets upstream remote.
    set-upstream = remote set-url upstream

    # Displays repo disk consumption
    size = git count-objects -v --human-readable

    # Pulls remota and auto-updates local submodules.
    spull = !git pull && git submodule sync --recursive && git submodule update --init --recursive

    # Pushes to remote, including all its submodules recursively.
    spush = push --recurse-submodules=on-demand

    # Views the current working tree status.
    st = status

    # Lists stashes.
    stashes = stash list

    # Update all submodules recursively.
    subup = submodule update --init --recursive

    # # Brings in remote changes and syncs back.
    # sync = !git pull --rebase && git push

    # Shows verbose output about tags.
    tags = tag -l

	# Create temporary branch using current commit.  Branch name uses tmp as prefix by default.
	tmp-br = "!f() { git branch "${1:-tmp}"$(date -u +'%Y-%m-%dT%H_%M_%SZ'); }; f"

    # Shows object type.
    type = cat-file -t

    # Undo commit and leaves files (only for non-public commits).
    uncommit = reset --soft HEAD^

    # Undo last commit.
    undo = reset --mixed HEAD~1

    # Unstage a file.
    unstage = reset HEAD --

    # Brings in remote changes.
    up = !git pull --rebase --prune $@ && git submodule update --init --recursive

    # Wipes savepoint.
    wipe = "!f() { rev=$(git rev-parse ${1-HEAD}); git add -A && git commit --allow-empty -qm '${WIPE SAVEPOINT' && git reset $rev --hard; }; f"
