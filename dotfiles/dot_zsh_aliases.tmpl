{{ "" }}
{{   template "assets.d/dot_zsh_aliases/linux/build.sh.tmpl" . }}
{{ "" }}
{{- else if eq .chezmoi.os "darwin" -}}
{{ "" }}
{{   template "assets.d/dot_zsh_aliases/common.sh.tmpl" . }}
{{ "" }}
{{- else if eq .chezmoi.os "windows" -}}
{{ "" }}
TODO: Update aliases
{{ "" }}
{{- else -}}
{{   fail (printf "Unsupported OS for the client system: %s" .chezmoi.os) }}
{{ end -}}
