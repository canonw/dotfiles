# -*-mode:conf-toml-*- vim:ft=toml

# ~/.local/share/chezmoi/dotfiles/.chezmoiexternal.toml.tmpl
# =============================================================================
# Used to interpreted as a list of external files and archives to be included
# as if they were in the source state.
#
# See https://www.chezmoi.io/reference/special-files/chezmoiexternal-format/
#
{{ if (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu")) -}}
{{   template "chezmoiexternal.d/ubuntu.toml.tmpl" . }}
{{ else if eq .chezmoi.os "darwin" -}}
{{   template "chezmoiexternal.d/macos.toml.tmpl" . }}
{{ else -}}
{{   fail (printf "Unsupported OS for the client system: %s" .chezmoi.os) }}
{{ end -}}
