# -*-mode:bash-*- vim:ft=bash

# {{ .chezmoi.targetFile | replaceAllRegex .chezmoi.homeDir "~" }}
# =============================================================================
# Executed by bash for non-login shells.
#
# See https://www.gnu.org/software/bash/manual/html_node/index.html

# shellcheck shell=bash
# shellcheck source=/dev/null
{{ if eq .chezmoi.os "linux" -}}
{{   template "assets.d/dot_bashrc/linux/build.sh.tmpl" . }}
{{- else if eq .chezmoi.os "darwin" -}}
{{   template "assets.d/dot_bashrc/darwin.sh.tmpl" . }}
{{- else if eq .chezmoi.os "windows" -}}

# TODO: Update setup

{{- else -}}
{{   fail (printf "Unsupported OS for the client system: %s" .chezmoi.os) }}
{{ end -}}
{{- /* TODO: Replace new style */ -}}
{{- $my_app := .include_app.default -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $my_app = .include_app.darwin -}}
{{- else if (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") (.chezmoi.kernel.osrelease | lower | contains "microsoft")) -}}
{{- $my_app = .include_app.ubuntu_wsl -}}
{{- end -}}

{{- if eq $my_app.chezmoi true }}
{{   template "assets.d/chezmoi/dot_bashrc.sh.tmpl" . }}
{{ else -}}
{{- end -}}

{{- if eq $my_app.direnv true }}
{{   template "assets.d/direnv/dot_bashrc.sh.tmpl" . }}
{{ else -}}
{{- end -}}

{{- if eq $my_app.gopass true }}
{{   template "assets.d/gopass/dot_bashrc.sh.tmpl" . }}
{{ else -}}
{{- end -}}

{{- if eq $my_app.lsd true }}
{{   template "assets.d/lsd/dot_bashrc.sh.tmpl" . }}
{{ else -}}
{{- end -}}

{{- if eq $my_app.ssh true }}
{{   template "assets.d/ssh/dot_bashrc.sh.tmpl" . }}
{{ else -}}
{{- end -}}
